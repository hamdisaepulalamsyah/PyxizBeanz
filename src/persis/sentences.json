[
  {
    "id": 1,
    "text": "Tahun 1923",
    "start": 0.0,
    "end": 2.308,
    "duration": 2.308,
    "start_frame": 0,
    "end_frame": 69
  },
  {
    "id": 2,
    "text": "beberapa pedagang di Bandung berkumpul untuk mengaji.",
    "start": 2.896,
    "end": 5.686,
    "duration": 2.79,
    "start_frame": 87,
    "end_frame": 171
  },
  {
    "id": 3,
    "text": "Dan mereka punya satu pertanyaan",
    "start": 6.164,
    "end": 7.827,
    "duration": 1.663,
    "start_frame": 185,
    "end_frame": 235
  },
  {
    "id": 4,
    "text": "Dalilnya mana?",
    "start": 8.36,
    "end": 9.328,
    "duration": 0.968,
    "start_frame": 251,
    "end_frame": 280
  },
  {
    "id": 5,
    "text": "Dua belas September 1923.",
    "start": 9.937,
    "end": 12.847,
    "duration": 2.91,
    "start_frame": 298,
    "end_frame": 385
  },
  {
    "id": 6,
    "text": "Haji Zamzam dan Haji Muhammad Yunus membuka sebuah kelompok kajian.",
    "start": 13.453,
    "end": 17.348,
    "duration": 3.895,
    "start_frame": 404,
    "end_frame": 520
  },
  {
    "id": 7,
    "text": "Setiap amalan ditimbang dengan Al-Qur'an dan Sunnah.",
    "start": 17.883,
    "end": 20.962,
    "duration": 3.079,
    "start_frame": 536,
    "end_frame": 629
  },
  {
    "id": 8,
    "text": "Mereka menamainya",
    "start": 21.438,
    "end": 22.45,
    "duration": 1.012,
    "start_frame": 643,
    "end_frame": 674
  },
  {
    "id": 9,
    "text": "Persatuan Islam.",
    "start": 22.857,
    "end": 24.009,
    "duration": 1.152,
    "start_frame": 686,
    "end_frame": 720
  },
  {
    "id": 10,
    "text": "Kemudian datang Ahmad Hassan,",
    "start": 24.633,
    "end": 26.265,
    "duration": 1.632,
    "start_frame": 739,
    "end_frame": 788
  },
  {
    "id": 11,
    "text": "ulama kelahiran Singapura.",
    "start": 26.521,
    "end": 27.849,
    "duration": 1.328,
    "start_frame": 796,
    "end_frame": 835
  },
  {
    "id": 12,
    "text": "Dia menulis, menjawab pertanyaan umat,",
    "start": 28.276,
    "end": 30.536,
    "duration": 2.26,
    "start_frame": 848,
    "end_frame": 916
  },
  {
    "id": 13,
    "text": "dan naik ke panggung debat terbuka.",
    "start": 30.819,
    "end": 32.632,
    "duration": 1.813,
    "start_frame": 925,
    "end_frame": 979
  },
  {
    "id": 14,
    "text": "Tahun 1929,",
    "start": 33.274,
    "end": 35.46,
    "duration": 2.186,
    "start_frame": 998,
    "end_frame": 1064
  },
  {
    "id": 15,
    "text": "majalah Pembela Islam terbit",
    "start": 35.865,
    "end": 37.437,
    "duration": 1.572,
    "start_frame": 1076,
    "end_frame": 1123
  },
  {
    "id": 16,
    "text": "dan isinya dibaca jauh di luar kota Bandung.",
    "start": 37.85,
    "end": 40.619,
    "duration": 2.769,
    "start_frame": 1136,
    "end_frame": 1219
  },
  {
    "id": 17,
    "text": "Desember 1934",
    "start": 41.229,
    "end": 43.614,
    "duration": 2.385,
    "start_frame": 1237,
    "end_frame": 1308
  },
  {
    "id": 18,
    "text": "di Ende, Flores",
    "start": 44.034,
    "end": 45.445,
    "duration": 1.411,
    "start_frame": 1321,
    "end_frame": 1363
  },
  {
    "id": 19,
    "text": "seorang tahanan politik mengirim surat untuk Ahmad Hassan.",
    "start": 45.723,
    "end": 48.672,
    "duration": 2.949,
    "start_frame": 1372,
    "end_frame": 1460
  },
  {
    "id": 20,
    "text": "Namanya Soekarno.",
    "start": 49.165,
    "end": 50.488,
    "duration": 1.323,
    "start_frame": 1475,
    "end_frame": 1515
  },
  {
    "id": 21,
    "text": "Hampir dua tahun mereka bertukar pikiran soal Islam dan kemajuan.",
    "start": 50.989,
    "end": 55.128,
    "duration": 4.139,
    "start_frame": 1530,
    "end_frame": 1654
  },
  {
    "id": 22,
    "text": "Pesantren Persis berdiri",
    "start": 55.641,
    "end": 57.039,
    "duration": 1.398,
    "start_frame": 1669,
    "end_frame": 1711
  },
  {
    "id": 23,
    "text": "lalu Ahmad Hassan pindah ke Bangil.",
    "start": 57.424,
    "end": 59.494,
    "duration": 2.07,
    "start_frame": 1723,
    "end_frame": 1785
  },
  {
    "id": 24,
    "text": "Salah satu muridnya, Mohammad Natsir, pada tiga April sembilan belas lima puluh mengajukan Mosi Integral",
    "start": 60.022,
    "end": 66.004,
    "duration": 5.982,
    "start_frame": 1801,
    "end_frame": 1980
  },
  {
    "id": 25,
    "text": "yang menyatukan kembali Indonesia dalam satu negara kesatuan.",
    "start": 66.339,
    "end": 69.757,
    "duration": 3.418,
    "start_frame": 1990,
    "end_frame": 2093
  },
  {
    "id": 26,
    "text": "Seratus tahun lebih kemudian",
    "start": 70.387,
    "end": 71.944,
    "duration": 1.557,
    "start_frame": 2112,
    "end_frame": 2158
  },
  {
    "id": 27,
    "text": "pengajian di Bandung itu sudah menjadi jam'iyah nasional.",
    "start": 72.201,
    "end": 75.251,
    "duration": 3.05,
    "start_frame": 2166,
    "end_frame": 2258
  },
  {
    "id": 28,
    "text": "Tapi pertanyaannya masih sama",
    "start": 75.645,
    "end": 77.296,
    "duration": 1.651,
    "start_frame": 2269,
    "end_frame": 2319
  },
  {
    "id": 29,
    "text": "Dalilnya mana?",
    "start": 77.719,
    "end": 78.916,
    "duration": 1.197,
    "start_frame": 2332,
    "end_frame": 2367
  }
]