{
  "name": "konten-video",
  "version": "1.0.0",
  "description": "PyxisLab 3D Animated Video Shorts Engine powered by Remotion, Three.js, and Pyxis BeanHead Style.",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "render:cikajang": "remotion render src/index.ts Cikajang out/cikajang.mp4 --gl=angle --concurrency=1 --scale=0.75",
    "render:persis": "remotion render src/index.ts Persis out/persis.mp4 --gl=angle --concurrency=1 --scale=0.75"
  },
  "dependencies": {
    "@react-three/fiber": "^9.0.0",
    "@remotion/bundler": "^4.0.529",
    "@remotion/cli": "4.0.529",
    "@remotion/renderer": "^4.0.529",
    "@remotion/three": "4.0.529",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.529",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/three": "^0.186.0",
    "typescript": "5.9.3"
  }
}
